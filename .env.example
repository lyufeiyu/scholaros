# ScholarOS 自身
SCHOLAROS_HOME=.scholaros
# 供应商中性的 OpenAI-compatible 示例；按你使用的服务替换这三项
SCHOLAROS_MODEL=your-model-name
SCHOLAROS_API_BASE=https://api.openai.com/v1
# 这里填写“保存真实 key 的环境变量名”，不要直接填写 key
SCHOLAROS_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=""
# 例如使用其他兼容服务时，可改成对应的模型、Base URL 和密钥变量名：
# SCHOLAROS_MODEL=deepseek-chat
# SCHOLAROS_API_BASE=https://api.deepseek.com
# SCHOLAROS_API_KEY_ENV=DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=""
# 模型调用始终使用非流式完整响应；长推理默认最多等待 300 秒
SCHOLAROS_MODEL_TIMEOUT_SECONDS=300
# auto 跟随供应商默认；也可填写 enabled 或 disabled
SCHOLAROS_MODEL_THINKING=auto
# 论文源检索使用独立的较短超时
SCHOLAROS_SOURCE_TIMEOUT_SECONDS=25

# 论文源（可选）
SCHOLAROS_CONTACT_EMAIL=you@example.com
SEMANTIC_SCHOLAR_API_KEY=
IEEE_XPLORE_API_KEY=
